    <style>
        :root {
            --mouse-x: 0.5;
            --mouse-y: 0.5;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        html { scroll-behavior: smooth; }

        body {
            font-family: 'Inter', sans-serif;
            background: #020105;
            color: #e2e8f0;
            overflow-x: hidden;
            cursor: none;
        }

        /* ===== CUSTOM CURSOR ===== */
        .cursor-system {
            position: fixed;
            top: 0; left: 0;
            pointer-events: none;
            z-index: 10000;
            mix-blend-mode: difference;
        }

        .cursor-core {
            width: 8px; height: 8px;
            background: #fff;
            border-radius: 50%;
            transform: translate(-50%, -50%);
            transition: transform 0.15s ease;
        }

        .cursor-ring {
            position: absolute;
            width: 40px; height: 40px;
            border: 1px solid rgba(255,255,255,0.3);
            border-radius: 50%;
            transform: translate(-50%, -50%);
            transition: width 0.3s, height 0.3s, border-color 0.3s;
        }

        .cursor-system.hover .cursor-core { transform: translate(-50%, -50%) scale(0); }
        .cursor-system.hover .cursor-ring {
            width: 60px; height: 60px;
            border-color: rgba(167, 139, 250, 0.5);
            background: rgba(167, 139, 250, 0.05);
        }

        /* ===== WEBGL ===== */
        #webgl-bg {
            position: fixed;
            inset: 0;
            z-index: -1;
            opacity: 0.6;
        }

        /* ===== VELOCITY SKEW ===== */
        .velocity-skew {
            transition: transform 0.1s linear;
            will-change: transform;
        }

        /* ===== 3D TILT ===== */
        .tilt-card {
            transform-style: preserve-3d;
            transition: transform 0.1s ease-out;
        }

        .tilt-content { transform: translateZ(40px); }

        /* ===== SPOTLIGHT ===== */
        .spotlight-section { position: relative; overflow: hidden; }
        .spotlight-mask {
            position: absolute;
            inset: 0;
            background: radial-gradient(
                600px circle at calc(var(--mouse-x) * 100%) calc(var(--mouse-y) * 100%),
                transparent 0%,
                rgba(2, 1, 5, 0.95) 100%
            );
            pointer-events: none;
        }

        /* ===== MARQUEE ===== */
        .marquee-track {
            display: flex;
            animation: marquee 30s linear infinite;
        }
        .marquee-track:hover { animation-play-state: paused; }
        @keyframes marquee {
            0% { transform: translateX(0); }
            100% { transform: translateX(-50%); }
        }

        /* ===== FLOATING DOCK ===== */
        .floating-dock {
            position: fixed;
            bottom: 2rem;
            left: 50%;
            transform: translateX(-50%) translateY(100px);
            z-index: 100;
            transition: transform 0.5s cubic-bezier(0.23, 1, 0.32, 1);
        }
        .floating-dock.visible { transform: translateX(-50%) translateY(0); }
        .dock-item {
            transition: all 0.3s cubic-bezier(0.23, 1, 0.32, 1);
        }
        .dock-item:hover {
            transform: translateY(-8px) scale(1.1);
        }

        /* ===== GRAIN ===== */
        .grain {
            position: fixed;
            inset: 0;
            pointer-events: none;
            z-index: 9998;
            opacity: 0.025;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 512 512' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.75' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
        }

        /* ===== KINETIC ===== */
        .kinetic {
            font-variation-settings: 'wght' 400;
            transition: font-variation-settings 0.3s ease;
        }
        .kinetic:hover { font-variation-settings: 'wght' 700; }

        /* ===== MAGNETIC ===== */
        .magnetic {
            transition: transform 0.3s cubic-bezier(0.23, 1, 0.32, 1);
        }

        /* ===== NOISE BTN ===== */
        .noise-btn {
            position: relative;
            overflow: hidden;
        }
        .noise-btn::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(105deg, transparent 40%, rgba(255,255,255,0.1) 50%, transparent 60%);
            transform: translateX(-100%);
            transition: transform 0.6s;
        }
        .noise-btn:hover::before { transform: translateX(100%); }

        /* ===== SELECTION ===== */
        ::selection {
            background: rgba(139, 92, 246, 0.4);
            color: #fff;
        }

        /* ===== SCROLLBAR ===== */
        ::-webkit-scrollbar { width: 4px; }
        ::-webkit-scrollbar-track { background: #020105; }
        ::-webkit-scrollbar-thumb { background: #2e1065; border-radius: 2px; }

        @media (pointer: coarse) {
            body { cursor: auto; }
            .cursor-system { display: none; }
        }
    </style>
